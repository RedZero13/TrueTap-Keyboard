<?xml version="1.0" encoding="utf-8"?>
<!-- TrueTap: a keycap with a tap landing dead-centre. Everything sits inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Keycap lip (gives the key some depth) -->
    <path
        android:fillColor="#FFC9CEF7"
        android:pathData="M41,36 h26 a9,9 0 0 1 9,9 v26 a9,9 0 0 1 -9,9 h-26 a9,9 0 0 1 -9,-9 v-26 a9,9 0 0 1 9,-9 z" />
    <!-- Keycap face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M41,32 h26 a9,9 0 0 1 9,9 v26 a9,9 0 0 1 -9,9 h-26 a9,9 0 0 1 -9,-9 v-26 a9,9 0 0 1 9,-9 z" />
    <!-- Outer tap ripple -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3B4BDB"
        android:strokeAlpha="0.35"
        android:strokeWidth="2.5"
        android:pathData="M54,54 m-14,0 a14,14 0 1 0 28,0 a14,14 0 1 0 -28,0" />
    <!-- Inner tap ripple -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3B4BDB"
        android:strokeAlpha="0.7"
        android:strokeWidth="2.5"
        android:pathData="M54,54 m-8.5,0 a8.5,8.5 0 1 0 17,0 a8.5,8.5 0 1 0 -17,0" />
    <!-- The tap -->
    <path
        android:fillColor="#FFFF6D3A"
        android:pathData="M54,54 m-4.5,0 a4.5,4.5 0 1 0 9,0 a4.5,4.5 0 1 0 -9,0" />
</vector>
